page {
  height: 100%;
  background: #10282e;
}

.crop-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #10282e;
}

.tip {
  padding: 16rpx 28rpx 12rpx;
  color: #e7f4f6;
}

.tip-size {
  font-size: 30rpx;
  font-weight: 700;
}

.tip-help {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(231, 244, 246, 0.82);
}

.warn.tight {
  margin-top: 10rpx;
}

.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  background: #10282e;
}

.photo {
  position: absolute;
  z-index: 1;
}

.dim {
  position: absolute;
  background: rgba(6, 16, 20, 0.52);
  z-index: 3;
}

.frame {
  position: absolute;
  z-index: 4;
  border: 2px solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.oval {
  position: absolute;
  left: 18%;
  top: 7%;
  width: 64%;
  height: 52%;
  border: 2px dashed rgba(255, 255, 255, 0.88);
  border-radius: 50%;
  box-sizing: border-box;
}

.shoulder {
  position: absolute;
  left: 8%;
  bottom: 7%;
  width: 84%;
  height: 26%;
  border: 2px dashed rgba(255, 255, 255, 0.45);
  border-bottom: none;
  border-radius: 50% 50% 0 0;
  box-sizing: border-box;
}

.stage-wait {
  position: absolute;
  left: 0;
  right: 0;
  top: 42%;
  text-align: center;
  color: #d5e8ec;
  z-index: 2;
}

.gesture {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
}

.dock {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.dock-row {
  display: flex;
}

.mini {
  flex: 1;
  height: 72rpx;
  margin: 0 8rpx;
  border-radius: 16rpx;
  background: #e7f3f4;
  color: #0f5562;
  font-size: 28rpx;
  font-weight: 600;
}

.dock .btn.half {
  flex: 1;
  margin: 8rpx 8rpx 0;
}

.page {
  background: #e7f3f4;
}
