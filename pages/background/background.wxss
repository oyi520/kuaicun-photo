.stage-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  background: #d5e4e8;
  border-radius: 28rpx;
  overflow: hidden;
  min-height: 240rpx;
}

.preview-canvas {
  display: block;
}

.stage-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 40, 46, 0.72);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
}

.stage-title {
  font-size: 34rpx;
  font-weight: 700;
}

.stage-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
}

.color-label {
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.swatches {
  display: flex;
  margin-top: 16rpx;
}

.swatch {
  flex: 1;
  margin-right: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx 0 14rpx;
  border: 3rpx solid transparent;
  text-align: center;
}

.swatch:last-child {
  margin-right: 0;
}

.swatch.on {
  border-color: #0f7384;
}

.swatch-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 auto;
  border: 2rpx solid rgba(20, 52, 60, 0.16);
}

.swatch-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.picker {
  margin-top: 16rpx;
}

.picker-line {
  font-size: 24rpx;
  color: #5c747a;
  margin-bottom: 8rpx;
}

.hue,
.light {
  position: relative;
  height: 48rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.hue {
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
}

.light {
  background: linear-gradient(90deg, #2a2a2a, #f4f4f4);
}

.thumb {
  position: absolute;
  top: 4rpx;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #14343c;
}

.hex-row {
  display: flex;
  align-items: center;
}

.hex {
  flex: 1;
}

.hex-btn {
  width: 140rpx;
  height: 88rpx;
  margin-left: 16rpx;
  border-radius: 16rpx;
  background: #0f7384;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.now {
  margin-top: 12rpx;
  color: #5c747a;
  font-size: 24rpx;
}

.brush {
  margin-top: 8rpx;
}

.brush-help {
  color: #3e5960;
  font-size: 26rpx;
}

.modes {
  display: flex;
  margin-top: 16rpx;
}

.mode {
  flex: 1;
  height: 80rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #e7f3f4;
  color: #14343c;
  font-size: 28rpx;
  font-weight: 600;
}

.mode:last-child {
  margin-right: 0;
}

.mode.on {
  background: #0f7384;
  color: #ffffff;
}

.dock-row {
  display: flex;
}

.dock-row .btn {
  flex: 1;
}
