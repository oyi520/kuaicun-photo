page {
  background: #e7f3f4;
  color: #14343c;
  font-size: 30rpx;
  line-height: 1.45;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view,
button,
input,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  text-align: center;
  border-radius: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100%;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
}

.h1 {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.sub {
  margin-top: 12rpx;
  color: #567178;
  font-size: 28rpx;
}

.privacy {
  margin-top: 28rpx;
  color: #5c747a;
  font-size: 26rpx;
  text-align: center;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.btn-primary {
  background: #0f7384;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #0f7384;
  border: 2rpx solid #b7d4da;
}

.btn-text {
  background: transparent;
  color: #0f7384;
  height: 80rpx;
  font-weight: 500;
}

.btn-hover {
  opacity: 0.86;
}

.btn[disabled] {
  opacity: 0.45;
}

.panel {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 72, 97, 0.06);
}

.warn {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff4e8;
  color: #8a4b12;
  font-size: 26rpx;
}

.note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #e5f4f6;
  color: #0f5562;
  font-size: 26rpx;
}

.field {
  height: 88rpx;
  background: #f3fafa;
  border-radius: 16rpx;
  border: 2rpx solid #c5dbe0;
  padding: 0 24rpx;
  font-size: 34rpx;
  color: #14343c;
}

.preview-box {
  height: 720rpx;
  background: #d5e4e8;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 100%;
}

.work-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 2px;
  height: 2px;
  opacity: 0;
  pointer-events: none;
}
